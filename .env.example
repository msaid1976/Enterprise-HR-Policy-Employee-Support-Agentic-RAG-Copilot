# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it holds live API keys.

# ---- LLM provider -----------------------------------------------------
# "groq" or "openai"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# ---- Embeddings ---------------------------------------------------------
# "openai" or "huggingface" — huggingface runs locally and needs no key
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Web search fallback -------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Vector store (Pinecone) ---------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fde-hr-policy-rag
PINECONE_NAMESPACE=company-hr-kb

# ---- Retrieval tuning -----------------------------------------------------
TOP_K=4
MAX_RETRIES=1

# ---- App / security ---------------------------------------------------
APP_NAME=Enterprise HR Policy Agentic RAG Copilot
APP_ENV=development
# Required in the "X-Admin-Key" header to upload/ingest new documents.
ADMIN_API_KEY=change-me-in-production

# ---- LangSmith tracing (optional) -----------------------------------------
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=FDE-HR_project

# ---- Optional path overrides ---------------------------------------------
# Defaults are computed from the project root; only set these to relocate
# storage (e.g. mounting a persistent volume in production).
# AUDIT_DB_PATH=./data/audit.db
# UPLOAD_DIR=./uploads
# SAMPLE_KB_DIR=./data/sample_kb
